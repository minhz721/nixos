/**
 * Catppuccin Mocha - Custom Rofi Theme Update
 * Optimized Selection Highlights and Visual Hierarchy
 **/

* {
    bg-col:           #1e1e2e; /* Base Dark Slate */
    bg-col-light:     #181825; /* Mantle Sub-panel Background */
    border-col:       #b4befe; /* Lavender Perimeter Accent */
    selected-col:     #313244; /* Surface 1: Clear Item Selection Container */
    blue:             #89b4fa; /* Soft Blue Component Highlight */
    fg-col:           #cdd6f4; /* Text Primary Value */
    fg-col2:          #b4befe; /* Lavender Focused Text Value */
    grey:             #6c7086; /* Overlay Dimmed Elements */
    width:            600;
    font:             "JetBrainsMono Nerd Font 12";
    border-radius:    10px;
    bg:      #1e1e2e; /* Base: Deep Primary Background */
    bg-alt:  #181825; /* Mantle: Secondary Input Panel Background */
    fg:      #cdd6f4; /* Text: Primary Text Value */
    accent:  #b4befe; /* Lavender: Pastel Highlight Component */
    border:  #b4befe; /* Lavender: Geometric Edge Border Control */
    main-bg: #282828E6;
    main-fg: #fbf1c7;
    select-bg: #d79921;
    select-fg: #282828;
}