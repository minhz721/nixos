@import "themes/catppuccin-mocha.rasi"


configuration {
    /* Core Mode Activation */
    modi:                       "drun,window";
    show-icons:                 true;
    icon-theme:                 "Papirus";
    terminal:                   "ghostty";
    
    /* Display Formatting */
    drun-display-format:        "{name}";
    window-display-format:      "{w} · {c} · {t}";
    
    /* Interface Labels */
    display-drun:               " Applications";
    display-window:             " Windows";
    
    /* Navigation Hotkeys within Rofi Menu */
    kb-mode-next:               "Shift+Right,Control+Tab";
    kb-mode-previous:           "Shift+Left";
}



/* --- SYSTEM WINDOW STRUCTURE --- */
window {
    width:            600px;
    border:           2px;
    border-radius:    12px;
    border-color:     @border;
    background-color: @bg;
    padding:          20px;
    font:             "JetBrainsMono Nerd Font 11";
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, mode-switcher, listview ];
    spacing:          15px;
}

/* --- VIEW CONTROLLER / MODE SWITCHER --- */
mode-switcher {
    background-color: transparent;
    spacing:          10px;
}

button {
    padding:          8px;
    background-color: @bg-alt;
    text-color:       #6c7086; /* Overlay 0: Unselected Mode Text */
    border-radius:    6px;
    horizontal-align: 0.5;
}

button selected {
    background-color: @accent;
    text-color:       @bg;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

/* --- DATA RENDER VIEW --- */
listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    spacing:          5px;
    cycle:            true;
    dynamic:          true;
}

element {
    background-color: transparent;
    text-color:       @fg;
    padding:          8px 12px;
    border-radius:    6px;
    spacing:          12px;
}

/* Operational Focused Matrix Status */
element selected.normal {
    background-color: @accent;
    text-color:       @bg;
}

element-icon {
    size:             24px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}
