{
	"$schema": "https://zed.dev",
	"name": "VSCode Dark Modern",
	"author": "Microsoft (ported)",
	"themes": [
		{
			"name": "VSCode Dark Modern",
			"appearance": "dark",
			"style": {
				"border": "#2b2b2b",
				"border.variant": "#2b2b2b",
				"border.focused": "#0078d4",
				"border.selected": "#0078d4",
				"border.transparent": "#00000000",
				"border.disabled": "#3c3c3c",
				"elevated_surface.background": "#202020",
				"surface.background": "#181818",
				"background": "#181818",
				"element.background": "#313131",
				"element.hover": "#2b2b2b",
				"element.active": "#0078d4",
				"element.selected": "#2b2b2b",
				"element.disabled": "#252526",
				"drop_target.background": "#0078d444",
				"ghost_element.background": "#00000000",
				"ghost_element.hover": "#ffffff11",
				"ghost_element.active": "#ffffff22",
				"ghost_element.selected": "#2b2b2b",
				"ghost_element.disabled": "#252526",
				"text": "#cccccc",
				"text.muted": "#9d9d9d",
				"text.placeholder": "#989898",
				"text.disabled": "#868686",
				"text.accent": "#4daafc",
				"icon": "#cccccc",
				"icon.muted": "#868686",
				"icon.disabled": "#6e7681",
				"icon.placeholder": "#989898",
				"icon.accent": "#0078d4",
				"status_bar.background": "#181818",
				"title_bar.background": "#181818",
				"title_bar.inactive_background": "#1f1f1f",
				"toolbar.background": "#1f1f1f",
				"tab_bar.background": "#181818",
				"tab.inactive_background": "#181818",
				"tab.active_background": "#1f1f1f",
				"search.match_background": "#9e6a0366",
				"panel.background": "#181818",
				"panel.focused_border": "#0078d4",
				"pane.focused_border": "#0078d4",
				"scrollbar.thumb.background": "#6e768166",
				"scrollbar.thumb.hover_background": "#86868688",
				"scrollbar.thumb.border": "#00000000",
				"scrollbar.track.background": "#00000000",
				"scrollbar.track.border": "#2b2b2b",
				"editor.foreground": "#cccccc",
				"editor.background": "#1f1f1f",
				"editor.gutter.background": "#1f1f1f",
				"editor.subheader.background": "#181818",
				"editor.active_line.background": "#2b2b2b66",
				"editor.highlighted_line.background": "#2b2b2b88",
				"editor.line_number": "#6e7681",
				"editor.active_line_number": "#cccccc",
				"editor.invisible": "#6e768188",
				"editor.wrap_guide": "#2b2b2b",
				"editor.active_wrap_guide": "#3c3c3c",
				"editor.document_highlight.read_background": "#2489db33",
				"editor.document_highlight.write_background": "#2489db55",
				"terminal.background": "#181818",
				"terminal.foreground": "#cccccc",
				"terminal.bright_foreground": "#ffffff",
				"terminal.dim_foreground": "#9d9d9d",
				"terminal.ansi.black": "#181818",
				"terminal.ansi.bright_black": "#6e7681",
				"terminal.ansi.red": "#f85149",
				"terminal.ansi.bright_red": "#f85149",
				"terminal.ansi.green": "#2ea043",
				"terminal.ansi.bright_green": "#3fb950",
				"terminal.ansi.yellow": "#e2c08d",
				"terminal.ansi.bright_yellow": "#e2c08d",
				"terminal.ansi.blue": "#0078d4",
				"terminal.ansi.bright_blue": "#4daafc",
				"terminal.ansi.magenta": "#c586c0",
				"terminal.ansi.bright_magenta": "#c586c0",
				"terminal.ansi.cyan": "#4ec9b0",
				"terminal.ansi.bright_cyan": "#4ec9b0",
				"terminal.ansi.white": "#cccccc",
				"terminal.ansi.bright_white": "#ffffff",
				"link_text.hover": "#4daafc",
				"conflict": "#e2c08d",
				"conflict.background": "#bb800933",
				"conflict.border": "#bb8009",
				"created": "#2ea043",
				"created.background": "#2ea04322",
				"created.border": "#2ea043",
				"deleted": "#f85149",
				"deleted.background": "#f8514922",
				"deleted.border": "#f85149",
				"error": "#f85149",
				"error.background": "#f8514922",
				"error.border": "#f85149",
				"hidden": "#868686",
				"hidden.background": "#181818",
				"hidden.border": "#2b2b2b",
				"hint": "#9d9d9d",
				"hint.background": "#26477844",
				"hint.border": "#2488db",
				"ignored": "#868686",
				"ignored.background": "#181818",
				"ignored.border": "#2b2b2b",
				"info": "#4daafc",
				"info.background": "#26477866",
				"info.border": "#0078d4",
				"modified": "#0078d4",
				"modified.background": "#0078d422",
				"modified.border": "#0078d4",
				"predictive": "#868686",
				"predictive.background": "#1f1f1f",
				"predictive.border": "#2b2b2b",
				"renamed": "#4daafc",
				"renamed.background": "#0078d422",
				"renamed.border": "#0078d4",
				"success": "#2ea043",
				"success.background": "#2ea04322",
				"success.border": "#2ea043",
				"unreachable": "#868686",
				"unreachable.background": "#181818",
				"unreachable.border": "#2b2b2b",
				"warning": "#e2c08d",
				"warning.background": "#bb800933",
				"warning.border": "#bb8009",
				"players": [
					{
						"cursor": "#cccccc",
						"background": "#0078d4",
						"selection": "#2489db55"
					}
				],
				"syntax": {
					"attribute": { "color": "#9cdcfe" },
					"boolean": { "color": "#569cd6" },
					"comment": { "color": "#6a9955", "font_style": "italic" },
					"comment.doc": {
						"color": "#6a9955",
						"font_style": "italic"
					},
					"constant": { "color": "#4fc1ff" },
					"constructor": { "color": "#4ec9b0" },
					"embedded": { "color": "#cccccc" },
					"emphasis": { "font_style": "italic" },
					"emphasis.strong": { "font_weight": 700 },
					"enum": { "color": "#4ec9b0" },
					"function": { "color": "#dcdcaa" },
					"hint": { "color": "#9d9d9d" },
					"keyword": { "color": "#569cd6" },
					"label": { "color": "#c8c8c8" },
					"link_text": { "color": "#4daafc" },
					"link_uri": { "color": "#4daafc" },
					"number": { "color": "#b5cea8" },
					"operator": { "color": "#d4d4d4" },
					"predictive": { "color": "#868686" },
					"preproc": { "color": "#c586c0" },
					"primary": { "color": "#cccccc" },
					"property": { "color": "#9cdcfe" },
					"punctuation": { "color": "#cccccc" },
					"punctuation.bracket": { "color": "#ffd700" },
					"punctuation.delimiter": { "color": "#cccccc" },
					"punctuation.list_marker": { "color": "#569cd6" },
					"punctuation.special": { "color": "#569cd6" },
					"string": { "color": "#ce9178" },
					"string.escape": { "color": "#d7ba7d" },
					"string.regex": { "color": "#d16969" },
					"string.special": { "color": "#d7ba7d" },
					"string.special.symbol": { "color": "#ce9178" },
					"tag": { "color": "#569cd6" },
					"text.literal": { "color": "#ce9178" },
					"title": { "color": "#569cd6", "font_weight": 700 },
					"type": { "color": "#4ec9b0" },
					"variable": { "color": "#9cdcfe" },
					"variable.special": { "color": "#569cd6" },
					"variant": { "color": "#4fc1ff" }
				}
			}
		}
	]
}
