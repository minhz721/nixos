{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 8,
  // Layout
  "modules-left": [
    // "niri/workspaces",
    // "niri/window"
    "sway/workspaces",
    "sway/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "cpu",
    "temperature",
    "memory",
    "pulseaudio",
    "custom/wallpaper",
    "custom/powermenu"
  ],
  // --- MODULE CONFIGURATIONS ---
  // "niri/workspaces": {
  //   "disable-scroll": true,
  //   "all-outputs": false,
  //   "sort-by-number": true,
  //   "format": "{index}"
  // },
  // "niri/window": {
  //   "format": "{}",
  //   "max-length": 40,
  //   "separate-outputs": true
  // },
  // Sway Workspaces 
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "sort-by-number": true,
    "format": "{name}"
    // "format-icons": {
    //     "default": "○",
    //     "focused": "●"
    // }
  },
  // Sway Window Title
  "sway/window": {
    "format": "{}",
    "max-length": 40,
    "icon": true,
    "icon-size": 16
  },
  "clock": {
    "format": " {:%H:%M   %d/%m/%Y}",
    "format-alt": " {:%H:%M:%S   %A, %d %B %Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    // "format": " {usage}%",
    "format": "CPU: {usage}%",
    "interval": 3,
    "on-click": ""
  },
  "memory": {
    "format": "RAM: {used}GB",
    "interval": 3
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "🔇 Mute",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  },
  "custom/powermenu": {
    "format": "",
    "tooltip": false,
    "on-click": "$HOME/.config/waybar/scripts/powermenu.sh"
  },
  "custom/wallpaper": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Toggle Wallpaper Panel",
    "on-click": "$HOME/.config/waybar/scripts/wallpaper.sh"
  },
  "temperature": {
    "hwmon-path-abs": "/sys/class/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 80,
    "format-critical": "🔥 {temperatureC}°C",
    "format": " {temperatureC}°C",
    "interval": 2
  },
}
